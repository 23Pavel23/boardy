server {
    listen 80;
    server_name pablo52.ai-info.ru;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pablo52.ai-info.ru;

    root /var/www/boardy/public;
    index index.php;

    ssl_certificate /etc/letsencrypt/live/pablo52.ai-info.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pablo52.ai-info.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    access_log /var/log/nginx/boardy-access.log;
    error_log /var/log/nginx/boardy-error.log;
}
