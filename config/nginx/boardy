
server {
    rewrite ^(/.well-known/acme-challenge/.*) $1 break; # managed by Certbot

    server_name pablo52.ai-info.ru;

    add_header Strict-Transport-Security "max-age=31536000" always;

    root /var/www/boardy;
    index index.html;

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    access_log /var/log/nginx/boardy-access.log;
    error_log /var/log/nginx/boardy-error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;

    listen 443 ssl; # managed by Certbot

    location /cgi-bin/ {
        gzip off;
        root /var/www/boardy;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy$fastcgi_script_name;
    }

    location = /submit {
        gzip off;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy/cgi-bin/submit.sh;
    }
    location ~ \.php$ {

fastcgi_pass unix:/var/run/php/php-fpm.sock;

include fastcgi_params;

fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
}

    ssl_certificate /etc/letsencrypt/live/pablo52.ai-info.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pablo52.ai-info.ru/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    rewrite ^(/.well-known/acme-challenge/.*) $1 break; # managed by Certbot

    if ($host = pablo52.ai-info.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name pablo52.ai-info.ru;
    return 404; # managed by Certbot
}
